{
  "name": "starmail",
  "version": "1.0.0",
  "description": "A local, starship-themed multi-account email client",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "imapflow": "^2.2.5",
    "mailparser": "^3.9.35",
    "nodemailer": "^10.0.14"
  },
  "devDependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/im-fell-dw-pica-sc": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/jolly-lodger": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/limelight": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "framer-motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "productName": "StarMail",
  "build": {
    "appId": "local.starmail",
    "productName": "StarMail",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  }
}
